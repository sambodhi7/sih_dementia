{
  "expo": {
    "name": "Saathi",
    "slug": "saathi-ui",
    "version": "0.1.0",
    "icon": "./assets/images/branding/saathi-app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "android": {
      "package": "in.saathi.cognitivecare",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFFDF8"
    },
    "plugins": [
      "expo-sqlite",
      ["expo-audio", { "microphonePermission": "Allow Saathi to record a family voice note." }],
      ["expo-image-picker", { "photosPermission": "Allow Saathi to choose a family photo or save a shared skill moment." }],
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "539499d1-b864-41ba-a924-3f96ee17fbfe"
      }
    }
  }
}
